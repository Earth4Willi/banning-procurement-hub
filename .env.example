# No real secrets in this file. Copy to .env.local and fill in real values.
# The site runs in server mode (Next.js route handlers) because quote/contact
# submissions need rate-limiting, validation and audit on the backend.

# --- Frontend ---
# Web3Forms access key for delivering quote/contact forms to banning173@gmail.com.
# After Isaac verifies the inbox at web3forms.com, paste the key below:
# NEXT_PUBLIC_WEB3FORMS_KEY=

# --- Backend runtime (required for route handlers) ---
# Origin of the deployed site; used for CSRF same-origin checks.
# Defaults to http://localhost:3000 when unset.
# APP_ORIGIN=https://www.banningprocurement.com

# Supabase project (URL + keys from Supabase dashboard).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (REST URL + token) for rate limiting and owner sessions.
# Passwords and TOTP secrets never touch Redis. Until these keys are set, the
# owner sign-in in the nav cannot complete end-to-end (sessions live in Redis);
# module behavior stays covered by unit tests.
# UPSTASH_REDIS_REST_URL=https://your-store.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Owner login. AUTH_SECRET must be >= 32 chars. OWNER_PASSWORD_HASH is a bcrypt
# hash (cost >= 12 in production) and OWNER_TOTP_SECRET a base32 2FA secret:
#   npx tsx -e "import('bcryptjs').then(b=>console.log(b.hashSync(<password>,12)))"
#   npx tsx -e "import('./src/server/totp.ts').then(m=>console.log(m.generateSecret()))"
# AUTH_SECRET=
# OWNER_EMAIL=banning173@gmail.com
# OWNER_PASSWORD_HASH=
# OWNER_TOTP_SECRET=

# Local-development only: opens the /admin dashboard without sign-in.
# Ignored in production and test. Never set this on Vercel.
# DEV_OWNER_BYPASS=1

# Session lifetimes (seconds).
# SESSION_ABS_TTL_SECONDS=604800
# SESSION_IDLE_TTL_SECONDS=1800